# The engine this pack's rules are checked and tested with
# (.github/workflows/publish.yml).
#
# RBB_REF is a commit of RBB_REPO, built from source and cached. Once a
# release of the engine reads rule language 2, name its tag in RBB_RELEASE
# instead and the workflow downloads the binary: no Rust toolchain needed.
RBB_REPO=bridge-craftwork/rusty-bidding-bot
RBB_REF=65b04d51967bf7ffbe4be0e400474e7b6f56815a
RBB_RELEASE=
