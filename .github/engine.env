# The engine this pack's rules are checked and tested with
# (.github/workflows/publish.yml).
#
# RBB_RELEASE is a release tag of RBB_REPO: the workflow downloads its
# Linux binary, so no Rust toolchain is needed. To check with a commit that
# has no release, empty RBB_RELEASE and name the commit in RBB_REF: it is
# built from source and cached.
RBB_REPO=bridge-craftwork/rusty-bidding-bot
RBB_REF=070f438135b185cfeee309a85ee6ccef3553aec4
RBB_RELEASE=
